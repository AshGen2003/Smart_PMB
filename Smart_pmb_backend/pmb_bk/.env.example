# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed — get the actual secret values from a teammate
# through a private channel (not GitHub), not from this file.

DJANGO_SECRET_KEY=generate-a-long-random-string-here
DJANGO_DEBUG=True

# Supabase Postgres — session pooler connection
DB_HOST=your-project.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional — matches Vercel preview deployment URLs by pattern, since each
# branch/PR gets a fresh unpredictable URL that CORS_ALLOWED_ORIGINS can't
# list individually. Replace "your-project-name" with the real Vercel
# project name once it exists. Leave unset if you don't need preview
# deployments to call this API.
# CORS_ALLOWED_ORIGIN_REGEXES=^https://your-project-name(-[a-z0-9-]+)?\.vercel\.app$

# Used to build the confirmation link sent in the account-confirmation email
FRONTEND_URL=http://localhost:3000

# Defaults cover local dev already — only set these once this is deployed
# somewhere with a real domain (e.g. Azure App Service):
# DJANGO_ALLOWED_HOSTS=your-app-name.azurewebsites.net
# CSRF_TRUSTED_ORIGINS=https://your-app-name.azurewebsites.net

# Only needed for a self-hosted VM deployment where Nginx (terminating TLS)
# and this Django process share the same machine: leave unset (defaults to
# the same value as DEBUG=False -> True) everywhere else. Set to False so
# plain-HTTP loopback traffic (a Next.js frontend on the same VM fetching
# from Django over 127.0.0.1) doesn't get redirected into a TLS port
# Gunicorn never actually serves — Nginx already enforces HTTPS for real
# public traffic in that setup, so Django's own redirect is redundant there.
# DJANGO_SECURE_SSL_REDIRECT=False

# Optional — switches uploaded media (profile pictures, generated PDFs)
# from local disk to Azure Blob Storage once a Storage Account exists.
# Leave blank to keep using local disk (fine for local dev).
# AZURE_ACCOUNT_NAME=
# AZURE_ACCOUNT_KEY=
# AZURE_CONTAINER=media

# Email is printed to the console by default. Set these to send real
# emails once you have an SMTP provider (e.g. Gmail + an App Password):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-address@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password
# DEFAULT_FROM_EMAIL=your-address@gmail.com

# Text.lk SMS gateway — used to send the forgot-password OTP code, and
# (for farmers who opt in under Settings) harvest status-change alerts.
# Left blank, messages are just logged instead of sent (accounts/sms.py),
# so this is optional for local dev.
# TEXTLK_API_TOKEN=your-text.lk-api-token
# TEXTLK_SENDER_ID=YourApprovedSenderId
# TEXTLK_API_URL=https://app.text.lk/api/v3/sms/send

# Must be the EXACT SAME value as JWT_SIGNING_KEY in my-app/.env.local —
# both apps sign/verify the same JWTs, so a mismatch breaks every login.
# Generate one shared value and use it in both places, don't regenerate
# your own.
JWT_SIGNING_KEY=

# Stripe (TEST MODE) — powers the system-change-request payment flow
# (a PMB officer requests a system change; the admin sets a fee to accept
# it; the officer pays via Stripe Checkout; a token is issued on success).
# Get test keys from https://dashboard.stripe.com/test/apikeys — never put
# a live (sk_live_...) key here. For local webhook delivery, run the
# Stripe CLI: `stripe listen --forward-to localhost:8000/api/stripe/webhook/`
# and use the webhook signing secret it prints (whsec_...).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Predictive warehouse-capacity alerts (farmers/forecasting.py) aren't run
# automatically — there's no task queue/scheduler in this codebase. In
# production, .github/workflows/capacity-forecast-schedule.yml calls
# POST /api/internal/run-capacity-forecasts/ once a day, which runs
# `manage.py check_capacity_forecasts` for you; set this to a long random
# value and put the same value in the repo's INTERNAL_TASK_SECRET Actions
# secret. Locally, just run the management command directly instead.
INTERNAL_TASK_SECRET=
