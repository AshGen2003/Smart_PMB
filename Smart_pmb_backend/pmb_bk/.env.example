# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed — get the actual secret values from a teammate
# through a private channel (not GitHub), not from this file.

DJANGO_SECRET_KEY=generate-a-long-random-string-here
DJANGO_DEBUG=True

# Supabase Postgres — session pooler connection
DB_HOST=your-project.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Used to build the confirmation link sent in the account-confirmation email
FRONTEND_URL=http://localhost:3000

# Email is printed to the console by default. Set these to send real
# emails once you have an SMTP provider (e.g. Gmail + an App Password):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-address@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password
# DEFAULT_FROM_EMAIL=your-address@gmail.com

# Must be the EXACT SAME value as JWT_SIGNING_KEY in my-app/.env.local —
# both apps sign/verify the same JWTs, so a mismatch breaks every login.
# Generate one shared value and use it in both places, don't regenerate
# your own.
JWT_SIGNING_KEY=
