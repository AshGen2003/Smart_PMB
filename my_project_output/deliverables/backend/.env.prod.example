# ── Django ──
DJANGO_SECRET_KEY=must-replace-with-a-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.smartpmb.example.com,localhost
CORS_ALLOWED_ORIGINS=https://smartpmb.example.com

# ── Database ──
DATABASE_URL=postgres://smart_pmb:secure_password@db:5432/smart_pmb

# ── Redis ──
REDIS_URL=redis://:redis_password@redis:6379/0

# ── Sentry ──
SENTRY_DSN=https://your-dsn@sentry.example.com/your-project

# ── Gunicorn (optional overrides) ──
# GUNICORN_WORKERS=4
# GUNICORN_TIMEOUT=120
# GUNICORN_LOG_LEVEL=info

# ── Next.js Public API URL ──
NEXT_PUBLIC_API_URL=https://smartpmb.example.com/api
