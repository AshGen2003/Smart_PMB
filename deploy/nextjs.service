[Unit]
Description=Smart PMB Next.js frontend
After=network.target

[Service]
User=deploy_user
Group=deploy_user
WorkingDirectory=/home/deploy_user/smart-pmb/my-app
EnvironmentFile=/home/deploy_user/smart-pmb/my-app/.env.local
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
