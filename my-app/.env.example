# Copy this file to .env.local and fill in real values. .env.local is
# gitignored and must never be committed — get the actual secret values
# from a teammate through a private channel (not GitHub), not from this file.

# No longer used by any code — Django (Smart_pmb_backend) is now the
# backend for both auth and data. Left here in case direct Postgres
# access to this project is wanted for something else later.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Django backend
NEXT_PUBLIC_DJANGO_API_URL=http://localhost:8000

# Optional — only needed on a same-host VM deployment where
# NEXT_PUBLIC_DJANGO_API_URL above is set to a loopback address
# (127.0.0.1) so server-side fetches skip Nginx/TLS. That loopback value
# is meaningless to an end user's browser, so the one browser-rendered
# use of the API URL (the harvest trace QR image, app/trace/TraceView.tsx)
# needs the real public URL instead. Leave unset for local dev, where
# NEXT_PUBLIC_DJANGO_API_URL is already reachable from the browser.
# NEXT_PUBLIC_DJANGO_PUBLIC_API_URL=https://api.your-vm-host.example.com

# Must be the EXACT SAME value as JWT_SIGNING_KEY in
# Smart_pmb_backend/pmb_bk/.env — both apps sign/verify the same JWTs, so
# a mismatch breaks every login. Generate one shared value and use it in
# both places, don't regenerate your own.
JWT_SIGNING_KEY=

# Google Maps JavaScript API — used by LocationMap for live vehicle
# tracking (driver dashboard + officer Transportation "Track" view).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional — only needed where the WebSocket notification endpoint isn't
# reachable at the same origin as this app (e.g. local dev: `next dev`
# runs on :3000 while the WS endpoint needs a separately-run `daphne`
# process, see Smart_pmb_backend/pmb_bk/.env.example's WS_PUSH_URL
# comment). Leave unset in production — the app then derives a
# same-origin wss:// URL from the page itself instead.
# NEXT_PUBLIC_WS_URL=ws://localhost:8001/ws/notifications/
