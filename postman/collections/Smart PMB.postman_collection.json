{
  "info": {
    "name": "Smart PMB",
    "description": "Auth + connectivity smoke-test requests for the Smart PMB Django REST API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{access_token}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Login",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"your-account@example.com\",\n  \"password\": \"your-password\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login/",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "login", ""]
        },
        "description": "Exchanges email+password for a JWT access+refresh pair. Saves both to the environment on success."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "pm.test(\"Response has access and refresh tokens\", function () {",
              "    pm.expect(body).to.have.property(\"access\");",
              "    pm.expect(body).to.have.property(\"refresh\");",
              "});",
              "",
              "if (body.access) pm.environment.set(\"access_token\", body.access);",
              "if (body.refresh) pm.environment.set(\"refresh_token\", body.refresh);"
            ]
          }
        }
      ]
    },
    {
      "name": "Token Refresh",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/refresh/",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "refresh", ""]
        },
        "description": "Exchanges the refresh token for a new access+refresh pair. Rotation is enabled on this backend, so the old refresh token is blacklisted after use — always save both values returned here, not just access."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "if (body.access) pm.environment.set(\"access_token\", body.access);",
              "if (body.refresh) pm.environment.set(\"refresh_token\", body.refresh);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Current User (smoke test)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/auth/me/",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "me", ""]
        },
        "description": "Requires a valid access_token. Confirms JWT auth is wired up end to end."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response has an email field\", function () {",
              "    pm.expect(pm.response.json()).to.have.property(\"email\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Districts (public connectivity check)",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/districts/",
          "host": ["{{base_url}}"],
          "path": ["api", "districts", ""]
        },
        "description": "AllowAny endpoint — no token needed. Use this first to confirm Postman can reach the server at all, before debugging auth."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
