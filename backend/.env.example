# --- Django core ---
# Secret key — CHANGE THIS in production to a long random string.
SECRET_KEY=django-insecure-change-me-to-a-long-random-string
# Comma separated allowed hosts.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DEBUG=True

# --- Database: Supabase Postgres (REQUIRED) -------------------------------
# 1. Open your Supabase project.
# 2. Go to Project Settings -> Database -> Connection string.
# 3. Choose "URI" and copy it. It looks like:
#    postgresql://postgres:YOUR_PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres?sslmode=require
# 4. Paste it below and replace YOUR_PASSWORD with your database password.
# --- Database ---
# Option A (recommended for local dev): a local PostgreSQL database.
#   1) Install PostgreSQL, then run:  psql -U postgres -f setup_db.sql
#   2) Use the line below (change the password only if you edited setup_db.sql):
DATABASE_URL=postgresql://smartpmb:SmartPMB2026@localhost:5432/smartpmb_db?sslmode=disable
#
# Option B (Supabase): replace with your Supabase URI.
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres?sslmode=require
#
# Leave DATABASE_URL empty to use the built-in local SQLite database.
DATABASE_URL=postgresql://smartpmb:SmartPMB2026@localhost:5432/smartpmb_db?sslmode=disable

# --- CORS (Next.js dev server) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend base url (optional, used in links/emails) ---
FRONTEND_URL=http://localhost:3000
